PORT=3000
# Option 1: set GOOGLE_APPLICATION_CREDENTIALS to a file path on the server
# Option 2: set FIREBASE_SERVICE_ACCOUNT to the JSON string of your service account
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# Groq AI Configuration (FREE - No payment required)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=mixtral-8x7b-32768
GROQ_TIMEOUT_MS=60000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (optional)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30

# Environment
NODE_ENV=development
